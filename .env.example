# Copy to `.env` for your own settings: `cp .env.example .env`
# `.env` is git-ignored. Never commit it.

# DE-1826: the storefront API token. While this is empty the API still accepts the old token that is
# hard-coded in fernhill/pipeline/orders.py. To rotate it, choose a new value here, then run
#   docker compose up -d
# so that the API and the workspace pick it up. From then on the old token is refused.
# STOREFRONT_API_TOKEN=

# DE-1821: dates on which the API answers 503, comma separated. Run docker compose up -d after changing it.
# STOREFRONT_OUTAGE_DATES=2026-08-12
